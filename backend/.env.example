# ---- Backend ----
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/prep-kit
SESSION_SECRET=change-me-to-a-long-random-string

# LLM provider (OpenAI-compatible chat completions endpoint).
# Works out of the box with Groq's free tier (https://console.groq.com) -
# create a key, set LLM_BASE_URL to https://api.groq.com/openai/v1 and
# LLM_MODEL to e.g. llama-3.1-8b-instant.
# Any other OpenAI-compatible free-tier provider (Google Gemini's OpenAI
# compat endpoint, OpenRouter free models, etc.) works the same way.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Optional: used for "public discussion of the interview process" search.
# Works with any provider exposing a simple web-search REST API on a free
# tier (e.g. Brave Search API, Tavily). If left blank the pipeline skips
# this step gracefully and records that no public discussion was found.
SEARCH_API_KEY=
SEARCH_BASE_URL=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000
